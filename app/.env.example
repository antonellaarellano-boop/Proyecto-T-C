# =============================================================================
# BALDECASH · TALENTO & CULTURA — Variables de entorno
# =============================================================================
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local a git (ya esta en .gitignore).
#
# En Vercel: Project Settings -> Environment Variables. Las marcadas como
# OBLIGATORIA deben estar cargadas o la app no funciona correctamente.
# -----------------------------------------------------------------------------

# --- Modo de datos ---------------------------------------------------------
# "mock"     -> datos simulados en memoria (para desarrollar la UI)
# "airtable" -> datos reales desde Airtable (requiere token y base abajo)
# OJO: si falta AIRTABLE_TOKEN o AIRTABLE_BASE_ID, la app cae a "mock"
# silenciosamente y solo deja un warning en consola.
DATA_SOURCE="airtable"

# --- Airtable --------------------------------------------------------------
# OBLIGATORIA. Personal Access Token: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=""

# OBLIGATORIA. Base ID (empieza con "app...")
AIRTABLE_BASE_ID=""

# Nombres EXACTOS de las tablas del core de Reclutamiento (case-sensitive).
# Si coinciden con estos defaults, podes omitirlas.
AIRTABLE_TABLE_CANDIDATES="Candidatos"
AIRTABLE_TABLE_VACANCIES="Vacantes"
AIRTABLE_TABLE_STAGES="Etapas"
AIRTABLE_TABLE_SOURCES="Fuentes"
AIRTABLE_TABLE_INGRESOS="Ingresos"
AIRTABLE_TABLE_SALARY_RANGE="Rango salarial"
AIRTABLE_TABLE_REVIEW_TIME="Tiempo de revision (head)"

# Nota: las tablas de Engagement, Merch, Bienestar y Pagos NO se configuran aca.
# Sus IDs estan hardcodeados en src/lib/data/airtable.ts.

# --- Autenticacion ---------------------------------------------------------
# OBLIGATORIA EN PRODUCCION. Minimo 32 caracteres.
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si falta en produccion, la app lanza error a proposito: sin esto las sesiones
# se firmarian con un secreto publicado en el repositorio.
AUTH_SECRET=""

# Duracion de sesion en segundos (default 8h)
AUTH_SESSION_TTL="28800"

# --- Admin bootstrap -------------------------------------------------------
# Credenciales del primer admin que se crea si el store de usuarios esta vacio.
# Cambiar la contrasena desde la app despues del primer login.
ADMIN_EMAIL="admin@baldecash.com"
ADMIN_PASSWORD=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Baldecash Talento & Cultura"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Upstash Redis / Vercel KV ---------------------------------------------
# RECOMENDADA EN PRODUCCION. Persiste los usuarios y catalogos auxiliares.
# Sin esto, los usuarios creados desaparecen en cada cold start de Vercel.
# Al conectar Upstash desde el Marketplace de Vercel, estas se inyectan solas.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Alternativa con los nombres nativos de Upstash (el codigo acepta ambos):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Sitios: Desk Buddy (Supabase externo, solo lectura) -------------------
# OPCIONAL. Si faltan, /dashboard/sitios muestra una pantalla "no configurado"
# en lugar de romper. Las 4 son necesarias juntas.
SITIOS_SUPABASE_URL=""
SITIOS_SUPABASE_ANON_KEY=""
SITIOS_SUPABASE_EMAIL=""
SITIOS_SUPABASE_PASSWORD=""

# --- Juegos de mesa (Supabase externo, solo lectura) -----------------------
# OPCIONAL. El RLS de SELECT es publico, asi que alcanza con la anon key.
JUEGOS_SUPABASE_URL=""
JUEGOS_SUPABASE_ANON_KEY=""
